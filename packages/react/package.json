{
  "name": "@recall-srs/react",
  "version": "0.4.0",
  "description": "Headless-first React components and hooks for spaced repetition. FSRS scheduling, bring your own styling.",
  "license": "MIT",
  "keywords": [
    "spaced-repetition",
    "srs",
    "fsrs",
    "react",
    "flashcards",
    "headless-ui",
    "hooks"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/verify-use-client.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@recall-srs/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sthabiso10/recall-srs.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Sthabiso10/recall-srs#readme",
  "bugs": {
    "url": "https://github.com/Sthabiso10/recall-srs/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
