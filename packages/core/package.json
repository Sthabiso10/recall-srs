{
  "name": "@recall-srs/core",
  "version": "0.2.1",
  "description": "Spaced repetition engine built on FSRS. Framework-agnostic, zero runtime dependencies.",
  "license": "MIT",
  "keywords": [
    "spaced-repetition",
    "srs",
    "fsrs",
    "sm-2",
    "flashcards",
    "learning",
    "scheduler",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./optimizer": "./src/optimizer/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./optimizer": {
        "types": "./dist/optimizer/index.d.ts",
        "import": "./dist/optimizer/index.js",
        "require": "./dist/optimizer/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sthabiso10/recall-srs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Sthabiso10/recall-srs#readme",
  "bugs": {
    "url": "https://github.com/Sthabiso10/recall-srs/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
