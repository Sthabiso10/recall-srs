{
  "name": "@recall-srs/core",
  "version": "0.1.1",
  "description": "Spaced repetition engine with FSRS and SM-2 schedulers. Framework-agnostic, zero runtime dependencies.",
  "license": "MIT",
  "keywords": [
    "spaced-repetition",
    "srs",
    "fsrs",
    "sm-2",
    "flashcards",
    "learning",
    "scheduler",
    "typescript"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sthabisod10/recall-srs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sthabisod10/recall-srs#readme",
  "bugs": {
    "url": "https://github.com/sthabisod10/recall-srs/issues"
  }
}
