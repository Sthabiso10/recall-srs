{
  "name": "@recall-srs/adapter-firebase",
  "version": "0.2.2",
  "description": "Skeleton: Firebase Firestore backend for Recall. Subcollection layout is defined; the queries are not implemented yet and throw.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests in @recall-srs/adapter-firebase yet\" && exit 0"
  },
  "dependencies": {
    "@recall-srs/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "firebase": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sthabiso10/recall-srs.git",
    "directory": "packages/adapters/firebase"
  },
  "homepage": "https://github.com/Sthabiso10/recall-srs#readme",
  "bugs": {
    "url": "https://github.com/Sthabiso10/recall-srs/issues"
  },
  "keywords": [
    "spaced-repetition",
    "srs",
    "firebase",
    "firestore",
    "flashcards"
  ],
  "engines": {
    "node": ">=18.17.0"
  }
}
