{
  "name": "@recall-srs/adapter-convex",
  "version": "0.1.1",
  "description": "Convex backend for Recall spaced repetition. Reactive queries and transactional grading.",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/convex",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no tests in @recall-srs/adapter-convex yet\" && exit 0"
  },
  "dependencies": {
    "@recall-srs/core": "workspace:*"
  },
  "peerDependencies": {
    "convex": "^1.16.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sthabiso10/recall-srs.git",
    "directory": "packages/adapters/convex"
  },
  "homepage": "https://github.com/Sthabiso10/recall-srs#readme",
  "bugs": {
    "url": "https://github.com/Sthabiso10/recall-srs/issues"
  },
  "keywords": [
    "spaced-repetition",
    "srs",
    "convex",
    "flashcards"
  ]
}
