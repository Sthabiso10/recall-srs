# React must resolve to a single instance across packages/react and the docs
# site, or hooks break with the classic "invalid hook call".
dedupe-peer-dependents=true
link-workspace-packages=true

# Peer dependencies are the consumer's to provide. Auto-installing them here
# would pull the entire Firebase SDK into this repo just because one adapter
# declares it as a peer.
auto-install-peers=false
strict-peer-dependencies=false
