{
  "name": "recall-srs",
  "version": "0.0.0",
  "private": true,
  "description": "A production-grade spaced repetition framework for React & TypeScript.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!@recall-srs/docs\" build",
    "dev": "pnpm -r --parallel --filter \"!@recall-srs/docs\" dev",
    "docs": "pnpm --filter @recall-srs/docs dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @recall-srs/core test:watch",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "pnpm -r exec rm -rf dist .next node_modules && rm -rf node_modules",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "size": "size-limit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "@size-limit/preset-small-lib": "^11.1.6",
    "size-limit": "^11.1.6"
  }
}
