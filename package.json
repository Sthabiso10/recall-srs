{
  "name": "recall-srs",
  "version": "0.0.0",
  "private": true,
  "description": "A production-grade spaced repetition framework for React & TypeScript.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!@recall-srs/docs\" build",
    "dev": "pnpm -r --parallel --filter \"!@recall-srs/docs\" dev",
    "docs": "pnpm --filter @recall-srs/docs dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @recall-srs/core test:watch",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "pnpm -r exec rm -rf dist .next node_modules && rm -rf node_modules",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "size": "size-limit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
